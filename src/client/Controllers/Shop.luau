--[[
	Shop
	Tools, bags, boots and treats. Colour-coded tabs, tier-tinted gradient cards with a live 3D
	preview, plain-language stats with icons ("+9 stud radius"), and clear buy / equip states.
	Prices and stats come from Config (generated by EconomicScaling).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Format = require(Shared.Format)
local Net = require(Shared.Net)
local Viewport = require(script.Parent.Viewport)
local GearModels = require(Shared.GearModels)

local Shop = {}

local C
local UI
local Juice
local tab = "Collector"
local list: ScrollingFrame
local tabButtons = {}
local priceButtons = {} -- buy buttons of the current tab: { Button, Price, Unlocked, Affordable }

local TABS = {
	{ Id = "Collector", Icon = "Pollen", Label = "Tools", Color = Color3.fromRGB(255, 140, 36), List = "Collectors", Owned = "OwnedCollectors", Equipped = "Collector" },
	{ Id = "Backpack", Icon = "Backpack", Label = "Bags", Color = Color3.fromRGB(64, 160, 255), List = "Backpacks", Owned = "OwnedBackpacks", Equipped = "Backpack" },
	{ Id = "Boots", Icon = "Lightning", Label = "Boots", Color = Color3.fromRGB(60, 200, 110), List = "Boots", Owned = "OwnedBoots", Equipped = "Boots" },
	{ Id = "Treats", Icon = "Treat", Label = "Treats", Color = Color3.fromRGB(255, 84, 160) },
}
local TAB_BY_ID = {}
for _, info in TABS do
	TAB_BY_ID[info.Id] = info
end

function Shop:Init(controllers)
	C = controllers
	UI = C.UI
	Juice = UI.Juice
end

local function tierColor(tier: number): Color3
	return Color3.fromHSV(((tier - 1) * 0.071 + 0.08) % 1, 0.5, 1)
end

-- Boots preview: the same procedural shoe players wear, on a stand-in foot
local function bootModel(def): Model
	return GearModels.Boot(def, Vector3.new(1, 0.55, 1.5))
end

local function card(order: number, title: string, tier: number?)
	local color = tier and tierColor(tier) or Color3.fromRGB(255, 200, 120)
	local frame = UI.Create("Frame", {
		LayoutOrder = order,
		BackgroundColor3 = Color3.new(1, 1, 1),
		Parent = list,
	}, { UI.Corner(20), UI.Gradient(color:Lerp(Color3.new(1, 1, 1), 0.35), Color3.fromRGB(255, 250, 240)) })
	UI.Create("Frame", {
		Name = "Gloss",
		Position = UDim2.new(0, 8, 0, 6),
		Size = UDim2.new(1, -16, 0, 40),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0.6,
		BorderSizePixel = 0,
		Parent = frame,
	}, { UI.Corner(14) })
	if tier then
		local ribbon = UI.Create("Frame", {
			Name = "Tier",
			Position = UDim2.fromOffset(10, 10),
			Size = UDim2.fromOffset(0, 22),
			AutomaticSize = Enum.AutomaticSize.X,
			BackgroundColor3 = color:Lerp(Color3.new(0, 0, 0), 0.25),
			ZIndex = 3,
			Parent = frame,
		}, { UI.Round(), UI.Create("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8) }) })
		UI.Create("TextLabel", {
			Size = UDim2.fromOffset(0, 22),
			AutomaticSize = Enum.AutomaticSize.X,
			BackgroundTransparency = 1,
			Font = UI.Font,
			TextSize = 14,
			TextColor3 = Color3.new(1, 1, 1),
			Text = "TIER " .. tier,
			ZIndex = 3,
			Parent = ribbon,
		})
	end
	local preview = UI.Create("Frame", { Name = "Preview", Position = UDim2.fromOffset(0, 8), Size = UDim2.new(1, 0, 0, 104), BackgroundTransparency = 1, Parent = frame })
	UI.Icon("Glow", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.55), Size = UDim2.fromOffset(120, 120), ImageColor3 = color, ImageTransparency = 0.35, Parent = preview })
	UI.Create("TextLabel", {
		Name = "Title",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(10, 112),
		Size = UDim2.new(1, -20, 0, 24),
		Font = UI.Font,
		TextSize = 20,
		TextTruncate = Enum.TextTruncate.AtEnd,
		TextColor3 = UI.Colors.Text,
		Text = title,
		Parent = frame,
	})
	Juice.Pop(frame, order * 0.02)
	return frame, preview
end

-- one readable stat line: icon + plain words, never cut off
local function statLine(frame: Instance, row: number, iconName: string, text: string)
	local y = 138 + (row - 1) * 22
	UI.Icon(iconName, { Position = UDim2.fromOffset(14, y), Size = UDim2.fromOffset(20, 20), Parent = frame })
	UI.Create("TextLabel", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(40, y),
		Size = UDim2.new(1, -48, 0, 20),
		Font = UI.Body,
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.None,
		TextColor3 = UI.Colors.Text,
		Text = text,
		Parent = frame,
	})
end

local function stats(frame: Instance, kind: string, item)
	if kind == "Collector" then
		statLine(frame, 1, "Pollen", `+{item.Power} pollen per flower`)
		statLine(frame, 2, "HexRing", `{item.Radius} stud field radius`)
		statLine(frame, 3, "Sparkles", `{string.format("%.2f", item.Cooldown)}s per swing`)
	elseif kind == "Backpack" then
		statLine(frame, 1, "Backpack", `{Format.Short(item.Capacity)} pollen capacity`)
		local previous = Config.Backpacks[item.Tier - 1]
		statLine(frame, 2, "Sparkles", previous and `+{math.floor((item.Capacity / previous.Capacity - 1) * 100 + 0.5)}% over {previous.Name}` or "Starter bag")
	elseif kind == "Boots" then
		statLine(frame, 1, "Lightning", item.Speed > 1 and `+{math.floor((item.Speed - 1) * 100 + 0.5)}% walk speed` or "Normal walk speed")
		statLine(frame, 2, "Sparkles", item.Trail and "Sparkle trail" or `{math.floor(Config.BaseWalkSpeed * item.Speed * 10 + 0.5) / 10} studs/s`)
	end
end

function Shop:_render()
	local data = C.State.Data
	if not data or not list then
		return
	end
	for _, child in list:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	table.clear(priceButtons)
	for id, button in tabButtons do
		local info = TAB_BY_ID[id]
		UI.SetButtonColor(button, id == tab and info.Color or info.Color:Lerp(Color3.fromRGB(230, 220, 205), 0.6))
		button.Size = id == tab and UDim2.fromOffset(150, 46) or UDim2.fromOffset(136, 40)
	end

	if tab == "Treats" then
		for i, count in { 1, 10, 100 } do
			local frame, preview = card(i, `{count} Treat{count > 1 and "s" or ""}`)
			UI.Icon("Treat", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.55), Size = UDim2.fromOffset(80, 80), Parent = preview })
			statLine(frame, 1, "Star", `+{Format.Short(Config.Levels.TreatXP * count)} bee XP`)
			UI.Button({ Text = Format.Short(Config.Levels.TreatPrice * count), Icon = "Honey", AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -10), Size = UDim2.new(1, -24, 0, 44), Parent = frame }, function()
				Net.Event("BuyTreats"):FireServer(count)
				C.Sound:Play("Purchase")
			end)
		end
		return
	end

	local info = TAB_BY_ID[tab]
	local items = Config[info.List]
	local owned = data[info.Owned] or {}
	local equipped = data[info.Equipped]
	for i, item in items do
		local frame, preview = card(i, item.Name, item.Tier)
		local model
		if tab == "Boots" then
			model = bootModel(item)
		elseif tab == "Backpack" then
			model = Viewport.Clone("Backpacks", item.Id) or Viewport.Clone("Backpacks", item.Shape)
		else
			model = Viewport.Clone("Collectors", item.Id) or Viewport.Clone("Collectors", item.Shape)
		end
		if model then
			Viewport.Model(preview, model, { Mode = "spin", Zoom = 0.95, Pitch = 18 })
		end
		stats(frame, tab, item)
		local button
		local at = { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -10), Size = UDim2.new(1, -24, 0, 42), Parent = frame }
		if equipped == item.Id then
			button = UI.Button({ Text = "EQUIPPED", Icon = "Check", BackgroundColor3 = UI.Colors.Good, AnchorPoint = at.AnchorPoint, Position = at.Position, Size = at.Size, MaxTextSize = 17, Parent = frame })
		elseif owned[item.Id] then
			button = UI.Button({ Text = "EQUIP", BackgroundColor3 = UI.Colors.Blue, AnchorPoint = at.AnchorPoint, Position = at.Position, Size = at.Size, Parent = frame }, function()
				Net.Event("Equip"):FireServer(tab, item.Id)
				C.Sound:Play("Click")
			end)
		else
			local previous = items[i - 1]
			local unlocked = not previous or owned[previous.Id]
			local affordable = (data.Honey or 0) >= item.Price
			local entry = { Price = item.Price, Unlocked = unlocked, Affordable = affordable }
			table.insert(priceButtons, entry)
			button = UI.Button({
				Text = unlocked and Format.Short(item.Price) or "LOCKED",
				Icon = unlocked and "Honey" or "Lock",
				BackgroundColor3 = (unlocked and affordable) and UI.Colors.Honey or Color3.fromRGB(200, 180, 150),
				AnchorPoint = at.AnchorPoint,
				Position = at.Position,
				Size = at.Size,
				MaxTextSize = 18,
				Parent = frame,
			}, function()
				if unlocked and (C.State.Data.Honey or 0) >= item.Price then
					Net.Event("Buy"):FireServer(tab, item.Id)
					C.Sound:Play("Purchase")
				else
					Juice.Shake(frame, 5)
					if not unlocked then
						C.NotificationCenter:Push(`Buy the {previous.Name} first`, "bad")
					end
				end
			end)
			entry.Button = button
		end
	end
end

-- honey changed: recolour price buttons in place instead of rebuilding every card
function Shop:_updateAffordable(honey: number)
	for _, entry in priceButtons do
		local affordable = honey >= entry.Price
		if entry.Button and entry.Unlocked and affordable ~= entry.Affordable then
			entry.Affordable = affordable
			UI.SetButtonColor(entry.Button, affordable and UI.Colors.Honey or Color3.fromRGB(200, 180, 150))
		end
	end
end

function Shop:Start()
	local content, panel = UI:Panel("Shop", "Shop", "Shop")
	-- tabs live on their own strip under the header, so nothing overlaps the title
	local tabs = UI.Create("Frame", { Name = "Tabs", Size = UDim2.new(1, 0, 0, 50), BackgroundTransparency = 1, Parent = content }, { UI.List(10, true, Enum.HorizontalAlignment.Center) })
	for i, info in TABS do
		tabButtons[info.Id] = UI.Button({ Name = info.Id, Text = info.Label, Icon = info.Icon, BackgroundColor3 = info.Color, LayoutOrder = i, Size = UDim2.fromOffset(136, 40), MaxTextSize = 18, Parent = tabs }, function()
			if tab ~= info.Id then
				tab = info.Id
				C.Sound:Play("Swish", { Volume = 0.6 })
				self:_render()
			end
		end)
	end
	list = UI.Create("ScrollingFrame", {
		Position = UDim2.fromOffset(0, 62),
		Size = UDim2.new(1, 0, 1, -62),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 5,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Parent = content,
	}, {
		UI.Create("UIGridLayout", { CellSize = UDim2.fromOffset(210, 260), CellPadding = UDim2.fromOffset(14, 14), HorizontalAlignment = Enum.HorizontalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder }),
		UI.Padding(8),
	})
	panel.OnOpen = function(openTab)
		if openTab and TAB_BY_ID[openTab] then
			tab = openTab
		end
		self:_render()
	end
	-- honey ticks many times a second while converting: rebuild only when something the
	-- cards show actually changed (affordability, ownership, equipped item)
	local lastSignature = ""
	local function signature(data)
		local info = TAB_BY_ID[tab]
		local parts = { tab, tostring(data.Treats) }
		if info.List then
			table.insert(parts, tostring(data[info.Equipped]))
			for _, item in Config[info.List] do
				local owned = data[info.Owned] and data[info.Owned][item.Id]
				table.insert(parts, owned and "o" or "-")
			end
		end
		return table.concat(parts, "|")
	end
	C.State:OnChange({ "Honey", "OwnedCollectors", "OwnedBackpacks", "OwnedBoots", "Collector", "Backpack", "Boots", "Treats" }, function(data)
		if UI.Current ~= "Shop" then
			return
		end
		local sig = signature(data)
		if sig ~= lastSignature then
			lastSignature = sig
			self:_render()
		else
			self:_updateAffordable(data.Honey or 0)
		end
	end)
end

return Shop
